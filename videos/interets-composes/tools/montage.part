      .ml-croix::before,
      .ml-croix::after,
      .ml-ko::before,
      .ml-ko::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 120%;
        height: 26px;
        margin: -13px 0 0 -60%;
        border-radius: 13px;
        background: #ff3b3b;
        transform: rotate(45deg);
