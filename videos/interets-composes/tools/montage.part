      /* ---- vidéo 17 : le mot secret ---- */
      .ms-cases {
        position: absolute;
        display: flex;
        gap: 24px;
      }
      .ms-cases i {
        display: grid;
        place-items: center;
        width: var(--t);
        height: calc(var(--t) * 1.2);
        border: 6px solid #dcfc1c;
        border-radius: 22px;
        background: repeating-linear-gradient(-45deg, #141414 0 18px, #0c0c0c 18px 36px);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
      }
      .ms-cases b {
        font-family: "Anton", sans-serif;
        font-weight: 400;
        font-size: calc(var(--t) * 0.8);
        line-height: 1;
        color: #dcfc1c;
        text-shadow: -6px 0 rgba(0, 229, 255, 0.7), 6px 0 rgba(255, 46, 99, 0.7);
      }
      .ms-bande {
        position: absolute;
        left: 0;
        top: 230px;
        display: flex;
        gap: 18px;
        filter: saturate(0.6) contrast(1.1);
      }
      .ms-bande i {
        flex: 0 0 360px;
        height: 203px;
        border: 6px solid #0c0c0c;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
      }
      .ms-bande img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .ms-frise {
        position: absolute;
        left: 160px;
        right: 160px;
        top: 500px;
        height: 70px;
      }
      .ms-frise b {
        position: absolute;
        left: 0;
        right: 0;
        top: 28px;
        height: 14px;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.25);
      }
      .ms-frise i {
        position: absolute;
        top: 10px;
        left: 8%;
        width: 50px;
        height: 50px;
        margin-left: -25px;
        border-radius: 50%;
        background: #ff3b3b;
        box-shadow: 0 0 30px rgba(255, 59, 59, 0.8);
      }
      .ms-frise span {
        position: absolute;
        left: 0;
        top: 80px;
        font-family: "JetBrains Mono", monospace;
        font-size: 32px;
        font-weight: 700;
        color: #ececec;
      }
      .ms-flou {
        position: absolute;
        left: 560px;
        top: 590px;
        width: 800px;
        height: 150px;
        display: grid;
        place-items: center;
        border-radius: 30px;
        background: #ff3d7f;
        box-shadow: 0 0 80px rgba(255, 61, 127, 0.7);
      }
      .ms-flou span {
        font-family: "Anton", sans-serif;
        font-size: 120px;
        line-height: 1;
        letter-spacing: 0.2em;
        color: #ffffff;
        filter: blur(9px);
      }
      .ms-chrono {
        position: absolute;
        right: 220px;
        top: 260px;
        font-family: "Anton", sans-serif;
        font-size: 200px;
        line-height: 1;
        color: #dcfc1c;
        text-shadow: 0 10px 50px rgba(0, 0, 0, 0.9);
      }
      .ms-premier {
        position: absolute;
        left: 200px;
        top: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: "Anton", sans-serif;
        text-transform: uppercase;
        color: #dcfc1c;
      }
      .ms-premier b {
        font-weight: 400;
        font-size: 300px;
        line-height: 1;
        text-shadow: 0 0 70px rgba(220, 252, 28, 0.5);
      }
      .ms-premier sup {
        font-size: 120px;
      }
      .ms-premier span {
        font-size: 64px;
        color: #ffffff;
      }
      .ms-faux {
        position: relative;
        width: 34px;
        height: 34px;
        margin-left: auto;
      }
      .ms-faux::before,
      .ms-faux::after {
        content: "";
        position: absolute;
        left: -4px;
        right: -4px;
        top: 14px;
        height: 7px;
        border-radius: 4px;
        background: #ff3b3b;
        transform: rotate(45deg);
      }
      .ms-faux::after {
        transform: rotate(-45deg);
      }
      .ms-cadeau {
        position: absolute;
        left: 960px;
        top: 530px;
        width: 820px;
        padding: 22px 30px;
        border-radius: 24px;
        background: #dcfc1c;
        color: #0c0c0c;
        font-family: "Anton", sans-serif;
        text-transform: uppercase;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      }
      .ms-cadeau b {
        display: block;
        font-weight: 400;
        font-size: 64px;
        line-height: 1;
      }
      .ms-cadeau span {
        font-size: 34px;
      }
      /* ---- vidéo 21 : faux site IRON CLUB ---- */
      .fi-site { position: absolute; inset: 0; font-family: "Inter", sans-serif; overflow: hidden; }
      .fi-violet { background: radial-gradient(ellipse 75% 70% at 50% 0%, #7c3aed 0%, #3b0f7a 40%, #0d0820 78%); color: #ffffff; }
      .fi-palette, .fi-pro { background: #111111; color: #f2ede4; }
      .fi-nav { position: absolute; left: 44px; right: 44px; top: 24px; display: flex; align-items: center; gap: 34px; font-size: 20px; font-weight: 500; }
      .fi-nav b { margin-right: auto; font-size: 28px; font-weight: 800; }
      .fi-nav em { font-style: normal; padding: 11px 24px; border-radius: 999px; font-weight: 700; font-size: 18px; }
      .fi-violet .fi-nav span { color: #c4b5fd; }
      .fi-palette .fi-nav span, .fi-pro .fi-nav span { color: #b9b3a8; }
      .fi-violet .fi-nav em, .fi-violet .fi-btn { background: linear-gradient(90deg, #8b5cf6, #ec4899); color: #ffffff; }
      .fi-palette .fi-nav em, .fi-palette .fi-btn, .fi-pro .fi-nav em { background: #e11d48; color: #ffffff; }
      .fi-hero { position: absolute; left: 60px; right: 60px; top: 100px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
      .fi-badge { padding: 8px 22px; border-radius: 999px; font-size: 19px; white-space: nowrap; }
      .fi-violet .fi-badge { border: 1px solid rgba(196, 181, 253, 0.5); color: #ddd6fe; background: rgba(124, 58, 237, 0.18); }
      .fi-palette .fi-badge { border: 1px solid #e11d48; color: #f2ede4; }
      .fi-hero h2 { margin: 0; font-size: 74px; font-weight: 800; line-height: 1.05; letter-spacing: -2px; }
      .fi-violet h2 { background: linear-gradient(90deg, #ffffff 10%, #c4b5fd 55%, #f0abfc 90%); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .fi-hero p { margin: 0; max-width: 860px; font-size: 23px; line-height: 1.4; }
      .fi-violet .fi-hero p { color: #c4b5fd; }
      .fi-palette .fi-hero p { color: #b9b3a8; }
      .fi-btn { padding: 16px 34px; border-radius: 999px; font-size: 21px; font-weight: 700; }
      .fi-cartes { position: absolute; left: 60px; right: 60px; bottom: 34px; display: flex; gap: 22px; }
      .fi-carte { flex: 1; height: 140px; border-radius: 18px; padding: 20px 24px; box-sizing: border-box; display: flex; flex-direction: column; gap: 8px; text-align: left; }
      .fi-carte i { width: 38px; height: 38px; border-radius: 10px; }
      .fi-carte b { font-size: 23px; font-weight: 800; }
      .fi-carte span { font-size: 17px; opacity: 0.7; }
      .fi-violet .fi-carte { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(196, 181, 253, 0.25); }
      .fi-violet .fi-carte i { background: linear-gradient(135deg, #8b5cf6, #ec4899); }
      .fi-palette .fi-carte { background: #1b1b1b; border: 1px solid #2c2c2c; }
      .fi-palette .fi-carte i { background: #e11d48; }
      .fi-pro .fi-nav b { font-family: "Anton", sans-serif; font-weight: 400; letter-spacing: 1px; font-size: 32px; }
      .fi-pro h2 { position: absolute; left: 56px; top: 104px; width: 640px; margin: 0; font-family: "Anton", sans-serif; font-weight: 400; font-size: 150px; line-height: 0.95; text-transform: uppercase; }
      .fi-pro h2 u { text-decoration: none; color: #e11d48; }
      .fi-pro p { position: absolute; left: 60px; top: 410px; width: 580px; margin: 0; font-size: 26px; line-height: 1.4; }
      .fi-pro .fi-btn { position: absolute; left: 60px; top: 520px; background: #e11d48; color: #ffffff; border-radius: 6px; }
      .fi-media { position: absolute; left: 700px; top: 96px; width: 500px; height: 440px; overflow: hidden; }
      .fi-stats { position: absolute; left: 700px; top: 556px; width: 500px; display: flex; justify-content: space-between; font-size: 18px; color: #b9b3a8; }
      .fi-stats b { display: block; font-family: "Anton", sans-serif; font-size: 42px; font-weight: 400; color: #f2ede4; }
      .fi-nuance { position: absolute; width: 170px; text-align: center; font-family: "Anton", sans-serif; font-size: 36px; color: #ecece8; text-transform: uppercase; }
      .fi-nuance i { display: block; width: 170px; height: 120px; border-radius: 16px; margin-bottom: 10px; box-sizing: border-box; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); }
      .fi-wire { position: absolute; width: 1060px; height: 640px; background: #141414; border: 3px solid #3a3a3a; border-radius: 18px; box-shadow: 0 40px 110px rgba(0, 0, 0, 0.75); }
      .fi-bloc { position: absolute; background: #2a2a2a; border: 3px solid #3a3a3a; border-radius: 12px; box-sizing: border-box; }
      .fi-compteur { position: absolute; width: 640px; padding: 26px 36px; background: #141414; border: 4px solid #ff4d4d; border-radius: 22px; text-align: center; font-family: "Anton", sans-serif; color: #ecece8; box-shadow: 0 40px 110px rgba(0, 0, 0, 0.75); }
      .fi-compteur span { display: block; font-size: 40px; text-transform: uppercase; color: #9a9a9a; }
      .fi-compteur b { display: block; font-size: 190px; font-weight: 400; line-height: 1.05; color: #ff4d4d; }
      .fi-compteur em { position: absolute; right: -30px; top: -30px; font-style: normal; font-size: 56px; background: #ff4d4d; color: #0c0c0c; padding: 4px 18px; transform: rotate(8deg); }
      /* ---- styles générés : fin ---- */
"""
CSS = CSS.replace("      /* ---- styles générés : fin ---- */", CSS_AJOUT + "      /* ---- styles générés : fin ---- */")


def ecrire_index():
    f = ICI / "index.html"
    h = f.read_text(encoding="utf-8")
    h = re.sub(r"      /\* ---- (clavier-ia|styles générés) : début.*?/\* ---- (clavier-ia|styles générés) : fin ---- \*/\n", "", h, flags=re.S)
    h = h.replace("    </style>\n  </head>", CSS + "    </style>\n  </head>", 1)
    lignes = [f'      <div id="fond" class="clip" data-start="0" data-duration="{FIN}" data-track-index="0"></div>', ""]
    for k, nom in enumerate(NOMS):
        d0, d1 = COUPES[k], COUPES[k + 1]
        lignes.append(f'      <div id="{nom}" data-composition-id="{nom}" data-composition-src="compositions/{nom}.html"\n'
                      f'        data-start="{d0}" data-duration="{round(d1 - d0, 2)}" data-track-index="1" data-track-kind="graphics"\n'
                      f'        data-width="1920" data-height="1080" style="z-index: 10"></div>')
    lignes += ["",
               f'      <div id="cadre" data-composition-id="cadre" data-composition-src="compositions/cadre.html"\n'
               f'        data-start="0" data-duration="{FIN}" data-track-index="2" data-track-kind="graphics"\n'
               f'        data-width="1920" data-height="1080" style="z-index: 40"></div>',
               f'      <div id="volets" data-composition-id="volets" data-composition-src="compositions/volets.html"\n'
               f'        data-start="0" data-duration="{FIN}" data-track-index="5" data-track-kind="graphics"\n'
               f'        data-width="1920" data-height="1080" style="z-index: 45"></div>',
               f'      <div id="sous-titres" data-composition-id="sous-titres" data-composition-src="compositions/sous-titres.html"\n'
               f'        data-start="0" data-duration="{FIN}" data-track-index="3" data-track-kind="captions"\n'
               f'        data-width="1920" data-height="1080" style="z-index: 50"></div>', "",
               '      <audio id="voix" src="assets/audio/voix.mp3" data-start="0" data-track-index="10"></audio>']
    for k, (d0, nom, dd, v) in enumerate(MUSIQUES):
        lignes.append(f'      <audio id="musique-{k + 1}" src="assets/music/{nom}.mp3" data-start="{d0}" data-duration="{dd}" '
                      f'data-volume="{v}" data-track-index="{11 + k % 2}"></audio>')
    pistes = {}
    for n, (d0, nom, v, note, dd) in enumerate(sorted(SONS), start=1):
        p = 30
        while pistes.get(p, -1) > d0 - 0.01:
            p += 1
        dd = round(min(dd, FIN - d0), 2)
        pistes[p] = d0 + dd
        lignes.append(f'      <audio id="sfx-{n:02d}" src="assets/sfx/{nom}.mp3" data-start="{d0}" data-duration="{dd}" '
                      f'data-volume="{v}" data-track-index="{p}"></audio><!-- {note} -->')
    corps = "\n".join(lignes)
    h = re.sub(r"(<div\n      id=\"root\"\n      data-composition-id=\"main\"\n      data-start=\"0\"\n      data-duration=\")[\d.]+(\"\n.*?>\n)(.*?)(\n    </div>\n    <script>)",
               lambda m: m.group(1) + str(FIN) + m.group(2) + corps + m.group(4), h, count=1, flags=re.S)
    f.write_text(h, encoding="utf-8")
    return len(SONS)



def ecrire_cadre():
    f = ICI / "compositions/cadre.html"
    h = f.read_text(encoding="utf-8")
    bloc = "\n".join(f"    masquer({round(a, 2)}, {round(c, 2)}); // {n}" for a, c, n in MASQUES) or "    // aucune carte plein écran"
    h = re.sub(r"(    function masquer\(debut, fin\) \{\n.*?\n    \}\n)(.*?)(    window\.__timelines)", lambda m: m.group(1) + bloc + "\n" + m.group(3),
               h, count=1, flags=re.S)
    f.write_text(h, encoding="utf-8")


def ecrire_volets():
    """Volet rayé (orange / bleu nuit) qui balaie l'image à chaque coupe et cache le raccord."""
    bandes, js = [], []
    for k, c in enumerate(COUPES[1:-1]):
        bandes.append(f'    <div id="vo-{k}" class="vo-bande"><i class="vo-r"></i><i class="vo-p"></i><i class="vo-r"></i></div>')
        js.append(f'    tl.fromTo("#vo-{k}", {{ x: 0 }}, {{ x: 5100, duration: 0.46, ease: "power2.inOut", immediateRender: false }}, {round(c - 0.23, 3)});')
    page = f"""<!-- Volets de transition du style « Alerte » (écrit par tools/construire-scenes.py). -->
<template>
  <style>
    #root {{
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }}
    .vo-bande {{
      position: absolute;
      left: -2700px;
      top: -300px;
      width: 2300px;
      height: 1680px;
      display: flex;
      transform: skewX(-18deg);
    }}
    .vo-r {{
      width: 170px;
      background: repeating-linear-gradient(-45deg, #dcfc1c 0 32px, #0c0c0c 32px 64px);
    }}
    .vo-p {{
      flex: 1;
      background: #0c0c0c;
    }}
  </style>
  <div id="root" data-composition-id="volets" data-width="1920" data-height="1080">
{chr(10).join(bandes)}
  </div>
  <script>
    const tl = gsap.timeline({{ paused: true }});
{chr(10).join(js)}
    window.__timelines["volets"] = tl;
  </script>
</template>
"""
    (ICI / "compositions/volets.html").write_text(page, encoding="utf-8")


def ecrire_check():
    """Les 6 types SOUS le film, dans la version verticale (../types-de-sites-vertical/index.html), en MYSTÈRE :
    6 cases verrouillées « ? » ; chacune se retourne et dévoile son nom au moment où la voix le dit, puis se valide."""
    cases, js = [], []
    cad = ('<svg class="ck-cad" viewBox="0 0 120 150" width="34" height="42"><path d="M30 70 L30 42 Q30 12 60 12 Q90 12 90 42 L90 70" fill="none" stroke="#ECECE8" stroke-width="14" stroke-linecap="round" />'
           '<rect x="14" y="66" width="92" height="76" rx="14" fill="#DCFC1C" /></svg>')
    for k, (m, g_act, g_ok) in enumerate(CHECK):
        cases.append(f'        <div id="ck-{k}" class="ck-case"><b>{k + 1}</b><span id="ck-q{k}" class="ck-q">?</span><span id="ck-n{k}" class="ck-nom" style="opacity: 0">{m}</span>'
                     f'<i id="ck-c{k}" class="ck-c">{cad}</i><i id="ck-v{k}" class="ck-v">{COCHE.format(w=34, c="#0C0C0C")}</i></div>')
        js.append(f'      tl.to("#ck-{k}", {{ keyframes: [{{ x: -6, duration: 0.05 }}, {{ x: 6, duration: 0.05 }}, {{ x: -4, duration: 0.05 }}, {{ x: 0, duration: 0.05 }}] }}, {round(g_act - 0.9, 3)});')
        js.append(f'      tl.to("#ck-{k}", {{ rotationY: 360, transformPerspective: 3000, duration: 0.4, ease: "power3.inOut" }}, {round(g_act - 0.05, 3)});')
        js.append(f'      tl.set("#ck-q{k}", {{ opacity: 0 }}, {round(g_act + 0.15, 3)});')
        js.append(f'      tl.set("#ck-c{k}", {{ opacity: 0 }}, {round(g_act + 0.15, 3)});')
        js.append(f'      tl.set("#ck-n{k}", {{ opacity: 1 }}, {round(g_act + 0.15, 3)});')
        js.append(f'      tl.set("#ck-{k}", {{ backgroundImage: "none" }}, {round(g_act + 0.15, 3)});')
        js.append(f'      tl.to("#ck-{k}", {{ borderColor: "#DCFC1C", backgroundColor: "rgba(220, 252, 28, 0.3)", scale: 1.08, duration: 0.18 }}, {round(g_act + 0.15, 3)});')
        js.append(f'      tl.to("#ck-{k}", {{ borderColor: "#DCFC1C", backgroundColor: "#DCFC1C", color: "#0C0C0C", scale: 1, duration: 0.16 }}, {round(g_ok - 0.05, 3)});')
        js.append(f'      tl.fromTo("#ck-v{k}", {{ opacity: 0, scale: 2 }}, {{ opacity: 1, scale: 1, duration: 0.14, ease: "power4.in", immediateRender: false }}, {round(g_ok - 0.05, 3)});')
    js.append(f'      tl.fromTo("#ck-barre", {{ opacity: 0, y: 80 }}, {{ opacity: 1, y: 0, duration: 0.3, ease: "back.out(1.8)" }}, {round(CHECK_DEBUT, 3)});')
    js.append(f'      tl.fromTo(".ck-case", {{ y: -60, opacity: 0 }}, {{ y: 0, opacity: 1, duration: 0.25, ease: "back.out(2)", stagger: 0.2, immediateRender: false }}, {round(CHECK_DEBUT, 3)});')
    largeur = round((1028 - 12 * (len(CHECK) - 1)) / len(CHECK))
    css = """      @font-face {
        font-family: "Anton";
        src: url("assets/fonts/Anton-Regular.woff2") format("woff2");
        font-weight: 400;
      }
      #ck-barre {
        position: absolute;
        left: 26px;
        top: 1318px;
        width: 1028px;
      }
      #ck-tete {
        font-family: "JetBrains Mono", monospace;
        font-weight: 700;
        font-size: 30px;
        letter-spacing: 0.15em;
        color: #dcfc1c;
        text-transform: uppercase;
        text-align: center;
        margin-bottom: 18px;
      }
      #ck-cases {
        display: flex;
        gap: 12px;
      }
      .ck-case {
        position: relative;
        width: 248px;
        height: 150px;
        border: 4px solid #3a4462;
        background: repeating-linear-gradient(-45deg, #141414 0 14px, #0c0c0c 14px 28px);
        color: #ecece8;
        font-family: "Anton", sans-serif;
        text-transform: uppercase;
        box-sizing: border-box;
      }
      .ck-case b {
        position: absolute;
        left: 12px;
        top: 6px;
        font-weight: 400;
        font-size: 40px;
        line-height: 1;
      }
      .ck-q {
        position: absolute;
        left: 0;
        right: 0;
        top: 22px;
        text-align: center;
        font-size: QSIZE;
        line-height: 1;
        color: #dcfc1c;
      }
      .ck-nom {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 16px;
        text-align: center;
        font-size: 30px;
        line-height: 1;
        white-space: nowrap;
      }
      .ck-c {
        position: absolute;
        right: 8px;
        top: 8px;
      }
      .ck-v {
        position: absolute;
        right: 8px;
        top: 8px;
        opacity: 0;
      }
""".replace("width: 248px;", f"width: {largeur}px;").replace("QSIZE", "70px" if len(CHECK) > 6 else "96px")
    html = (f'      <div id="ck-barre" class="clip" data-start="0" data-duration="{FIN}" data-track-index="3" style="opacity: 0">\n'
            f'        <div id="ck-tete">{CHECK_TITRE}</div>\n        <div id="ck-cases">\n' + "\n".join("  " + c for c in cases) +
            "\n        </div>\n      </div>")
    f = ICI.parent / "interets-composes-vertical/index.html"
    h = f.read_text(encoding="utf-8")
    h = re.sub(r"(      /\* check : début \*/\n).*?(      /\* check : fin \*/)", lambda m: m.group(1) + css + m.group(2), h, flags=re.S)
    h = re.sub(r"(      <!-- check : début -->\n).*?(      <!-- check : fin -->)", lambda m: m.group(1) + html + "\n" + m.group(2), h, flags=re.S)
    h = re.sub(r"(      // check : début\n).*?(      // check : fin)", lambda m: m.group(1) + "\n".join(js) + "\n" + m.group(2), h, flags=re.S)
    f.write_text(h, encoding="utf-8")


def couleurs_alerte():
    """Remplace l'accent vert-jaune du style « Projecteur » par l'orange du style « Alerte » dans les scènes."""
    for f in (ICI / "compositions").glob("s*.html"):
        h = f.read_text(encoding="utf-8")
        h = h.replace("#DCFC1C", ACCENT).replace("#dcfc1c", ACCENT).replace("rgba(220, 252, 28", "rgba(220, 252, 28")
        f.write_text(h, encoding="utf-8")
    st = ICI / "compositions/sous-titres.html"
    h = st.read_text(encoding="utf-8")
    if "style Alerte" not in h:
        h = h.replace("    .st-mot {\n", "    /* style Alerte */\n    .st-bandeau {\n      box-shadow: 10px 10px 0 #dcfc1c;\n      transform: skewX(-6deg);\n    }\n    .st-mot {\n", 1)
        st.write_text(h, encoding="utf-8")


for nom in NOMS:
    contenu = (ICI / "compositions" / f"{nom}.html").read_text(encoding="utf-8")
    assert not re.search(rf'(?<![-\w])id="{nom}"|"#{nom}"', contenu), f"un élément porte l'identifiant de la scène {nom}"
ecrire_volets()
def sans_check():
    """Pas de cases sous le film dans cette vidéo (demande de l'utilisateur) : on vide les trois blocs « check » de la version verticale."""
    f = ICI.parent / "interets-composes-vertical/index.html"
    h = f.read_text(encoding="utf-8")
    h = re.sub(r"(      /\* check : début \*/\n).*?(      /\* check : fin \*/)", lambda m: m.group(1) + m.group(2), h, flags=re.S)
    h = re.sub(r"(      <!-- check : début -->\n).*?(      <!-- check : fin -->)", lambda m: m.group(1) + m.group(2), h, flags=re.S)
    h = re.sub(r"(      // check : début\n).*?(      // check : fin)", lambda m: m.group(1) + m.group(2), h, flags=re.S)
    f.write_text(h, encoding="utf-8")


sans_check()
n = ecrire_index()
ecrire_cadre()
print(f"{len(NOMS)} scènes écrites, {n} bruitages placés, fin à {FIN} s")


# ================================================================ COULEURS DE LEFINANCIER (bleu ciel sur bleu nuit) ET VERSION VERTICALE
REMPLACE = [("#DCFC1C", "#38BDF8"), ("#dcfc1c", "#38bdf8"), ("rgba(220, 252, 28", "rgba(56, 189, 248"), ("rgba(220,252,28", "rgba(56,189,248"),
            ("#0C0C0C", "#0B1220"), ("#0c0c0c", "#0b1220"), ("rgba(12, 12, 12", "rgba(11, 18, 32"), ("#141414", "#13203A"), ("#0a0a06", "#08101E")]


def bleu_ciel(f):
    h = f.read_text(encoding="utf-8")
    for a, b in REMPLACE:
        h = h.replace(a, b)
    f.write_text(h, encoding="utf-8")


for f in [ICI / "index.html", *(ICI / "compositions").glob("*.html")]:
    bleu_ciel(f)
V = ICI.parent / "interets-composes-vertical/index.html"
h = V.read_text(encoding="utf-8")
h = __import__("re").sub(r'("default":")Ton site crie[^"]*(")', r"\1Même somme, même taux : l’une finit avec le double\2", h)
h = __import__("re").sub(r'(data-var-text="titre">\s*)Ton site crie[^<]*?(\s*</h1>)', r"\1Même somme, même taux : l’une finit avec le double\2", h)
h = h.replace("site-fait-par-ia-16x9.mp4", "interets-composes-16x9.mp4")
h = __import__("re").sub(r'data-duration="[\d.]+"', f'data-duration="{FIN}"', h)
h = h.replace("background: #000;", "background: #0B1220;")
V.write_text(h, encoding="utf-8")
bleu_ciel(V)
print("couleurs bleu ciel appliquées")
