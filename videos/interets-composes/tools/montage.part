        color: #ecece8;
      }
      .ty-niveau b {
        font-weight: 400;
        font-size: 230px;
        line-height: 1;
        color: #ff5fa2;
        text-shadow: 0 0 70px rgba(255, 95, 162, 0.6);
      }
      .ty-lab {
        position: absolute;
        left: 18px;
        bottom: 18px;
        padding: 4px 18px;
        background: #dcfc1c;
        color: #0c0c0c;
        font-family: "Anton", sans-serif;
        font-size: 44px;
        line-height: 1.1;
        text-transform: uppercase;
      }
      .ty-grande-q {
        position: absolute;
        left: 0;
        width: 1920px;
        top: 250px;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: "Anton", sans-serif;
        text-transform: uppercase;
        line-height: 1.02;
      }
      .ty-grande-q span {
        font-size: 150px;
        color: #ffffff;
        white-space: nowrap;
      }
      .ty-grande-q span:last-child {
        color: #dcfc1c;
        text-shadow:
          -7px 0 rgba(0, 229, 255, 0.75),
          7px 0 rgba(255, 46, 99, 0.75),
          0 0 60px rgba(220, 252, 28, 0.45);
      }
      /* ---- vidéo 14 : site multilingue ---- */
      .lx {
        display: inline-grid;
      }
      .lx > span,
      .lx > b,
      .lx > i {
        grid-area: 1 / 1;
      }
      .dr {
        display: inline-block;
        width: 40px;
        height: 28px;
        margin-right: 10px;
        border-radius: 4px;
        vertical-align: -5px;
