        width: 300px;
        height: 300px;
      }
      .ty-cible i {
        position: absolute;
        border-radius: 50%;
        border: 14px solid #3dffa2;
      }
      .ty-cible i:nth-child(1) {
        inset: 0;
      }
      .ty-cible i:nth-child(2) {
        inset: 60px;
      }
      .ty-cible i:nth-child(3) {
        inset: 120px;
        background: #3dffa2;
      }
      .ty-niveau {
        position: absolute;
        left: 170px;
        top: 330px;
        display: flex;
        flex-direction: column;
