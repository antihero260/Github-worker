      }
      .ty-ent-h {
        top: 0;
      }
      .ty-ent-b {
        top: 400px;
      }
      .ty-ent-h b,
      .ty-ent-b b {
        font-weight: 400;
        font-size: 96px;
        line-height: 1;
      }
      .ty-ent-b b {
