# ================================================================ SONS GÉNÉRAUX
for k, c in enumerate(COUPES[1:-1], start=1):
    son(c, tour(TRANSITIONS + ["balaie-rapide", "balaie-air"]), 0.44, f"volet vers {NOMS[k]}")

MUSIQUES = [  # fichiers à −17,1 / −17,1 / −17,5 LUFS → ≈ −21 LUFS (5 dB sous la voix)
    (0, "partie-1-lord-knows", COUPES[3], 0.64),
    (COUPES[3], "partie-2-thunder", round(COUPES[6] - COUPES[3], 2), 0.64),
    (COUPES[6], "partie-3-head-bang", round(FIN - COUPES[6], 2), 0.67),
]
MASQUES = []
_vus = set()
SONS[:] = [x for x in SONS if not ((x[0], x[1]) in _vus or _vus.add((x[0], x[1])))]

