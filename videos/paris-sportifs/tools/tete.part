            f'<div class="fi-stats"><span><b>340</b>membres</span><span><b>4,9/5</b>sur Google</span><span><b>12</b>coachs</span></div></div>')


def fenetre_site(s, fid, x, y, sc, couches, g, url=URL):
    """Fenêtre de navigateur 1240×720 réduite à l'échelle sc ; couches : HTML des versions du site, empilées."""
    cam(s, f'<div id="{fid}" class="al-nav" style="left: {x}px; top: {y}px; width: {SITE_W}px; height: {SITE_H}px; opacity: 0">'
           f'<div class="al-nav-barre"><i></i><i></i><i></i><span>{url}</span></div><div class="al-nav-corps">{"".join(couches)}</div></div>')
    s.j(f'tl.set("#{fid}", {{ scale: {sc}, transformOrigin: "0% 0%" }}, 0);')
    s.j(f'tl.fromTo("#{fid}", {{ opacity: 0, y: 160 }}, {{ opacity: 1, y: 0, duration: 0.3, ease: "back.out(1.5)", immediateRender: false }}, {s.L(g)});')
    son(g, tour(["pop-long", "swoosh-accent", "papier-glisse"]), 0.42, "le site apparaît")


def balaie_version(s, sel, g, d=0.55):
    """La nouvelle version du site remplace l'ancienne : volet de gauche à droite, trait lumineux, son de scan."""
    s.j(f'tl.fromTo("{sel}", {{ clipPath: "inset(0% 100% 0% 0%)" }}, {{ clipPath: "inset(0% 0% 0% 0%)", duration: {d}, ease: "power2.inOut", immediateRender: false }}, {s.L(g)});')
    son(g, "scanner", 0.45, "la version corrigée balaie l'ancienne")
    son(g + d, tour(["notif-magique", "scintille", "cloche-succes"]), 0.4, "version corrigée")


def nuance3(s, p, x, y, couleurs, temps, noms):
    for k, (c, t, n) in enumerate(zip(couleurs, temps, noms)):
        bord = "border: 3px solid #3a3a3a;" if c == "#111111" else ""
        cam(s, f'<div id="{p}-{k}" class="fi-nuance" style="left: {x + k * 190}px; top: {y}px; opacity: 0"><i style="background: {c}; {bord}"></i><span>{n}</span></div>')
        s.j(f'tl.fromTo("#{p}-{k}", {{ opacity: 0, y: 80, rotation: {(-8, 6, -4)[k]} }}, {{ opacity: 1, y: 0, rotation: 0, duration: 0.24, ease: "back.out(2.2)", immediateRender: false }}, {s.L(t)});')
        son(t, tour(["pop-sec", "pop-bulle", "pop-click"]), 0.42, f"couleur {n}")


def wireframe(s, p, x, y, g):
    blocs = [("titre", 140, 40, 780, 120), ("sous", 300, 180, 460, 40), ("c0", 60, 280, 300, 170), ("c1", 380, 280, 300, 170), ("c2", 700, 280, 300, 170),
             ("a0", 60, 480, 300, 110), ("a1", 380, 480, 300, 110), ("a2", 700, 480, 300, 110)]
    html = "".join(f'<i id="{p}-{n}" class="fi-bloc" style="left: {bx}px; top: {by}px; width: {bw}px; height: {bh}px"></i>' for n, bx, by, bw, bh in blocs)
    cam(s, f'<div id="{p}" class="fi-wire" style="left: {x}px; top: {y}px; opacity: 0">{html}</div>')
    s.j(f'tl.fromTo("#{p}", {{ opacity: 0, scale: 0.8 }}, {{ opacity: 1, scale: 1, duration: 0.25, ease: "back.out(1.8)", immediateRender: false }}, {s.L(g)});')
    son(g, "construit", 0.4, "le squelette du site")


def allume(s, p, noms, g, etiquette_txt, ex, ey):
    sel = ", ".join(f"#{p}-{n}" for n in noms)
    s.j(f'tl.to([{", ".join(chr(34) + "#" + p + "-" + n + chr(34) for n in noms)}], {{ backgroundColor: "rgba(220, 252, 28, 0.85)", borderColor: "#DCFC1C", duration: 0.12, stagger: 0.06 }}, {s.L(g)});')
    puce(s, f"{p}-e{noms[0]}", etiquette_txt, ex, ey, g + 0.05, "font-size: 40px")
    son(g, tour(["clic-positif", "coche", "pop-click"]), 0.45, f"bloc : {etiquette_txt}")
    del sel


def compteur_carte(s, cid, x, y, g, de, a, d):
    cam(s, f'<div id="{cid}" class="fi-compteur" style="left: {x}px; top: {y}px; opacity: 0"><span>Visiteurs en direct</span><b id="{cid}-n">{de}</b>'
           f'<em id="{cid}-f">−97 %</em></div>')
    s.j(f'tl.fromTo("#{cid}", {{ opacity: 0, scale: 0.6 }}, {{ opacity: 1, scale: 1, duration: 0.2, ease: "back.out(2)", immediateRender: false }}, {s.L(g)});')
    s.compteur(f"#{cid}-n", g + 0.1, de, a, d)
    s.j(f'tl.fromTo("#{cid}-f", {{ opacity: 0, scale: 2 }}, {{ opacity: 1, scale: 1, duration: 0.14, ease: "power4.in", immediateRender: false }}, {s.L(g + d)});')
    son(g + 0.1, "alarme-alerte", 0.3, "les visiteurs fuient", d=round(d + 0.3, 2))



# ================================================================ ÉLÉMENTS DE LEFINANCIER (vidéo 1 : l'inflation)
BLEU, NUIT, OR = "#38BDF8", "#0B1220", "#F2B705"


def fcfa(n):
    return f"{n:,}".replace(",", " ")


def compteur_fcfa(s, sel, g, de, a, d):
    """Compteur en FCFA avec espaces entre les milliers (100 000 → 105 000)."""
    s.n_proxy += 1
    p = f"f{s.n_proxy}"
    s.j(f'const {p} = {{ v: {de} }};')
    s.j(f'tl.fromTo({p}, {{ v: {de} }}, {{ v: {a}, duration: {d}, ease: "power2.out", immediateRender: false, '
        f'onUpdate: () => {{ document.querySelector("{sel}").textContent = String(Math.round({p}.v)).replace(/\\B(?=(\\d{{3}})+(?!\\d))/g, "\\u202f"); }} }}, {s.L(g)});')


def solde(s, sid, x, y, g, montant, titre_s="Compte Wave", w=560):
    """Carte « solde » d'un compte mobile money (dessinée, sans logo)."""
    cam(s, f'<div id="{sid}" class="fi-solde" style="left: {x}px; top: {y}px; width: {w}px; opacity: 0">'
           f'<div class="fi-solde-tete"><i></i>{titre_s}</div><span>Solde disponible</span>'
           f'<div class="fi-solde-n"><b id="{sid}-n">{fcfa(montant)}</b><em>FCFA</em></div>'
           f'<div id="{sid}-pied" class="fi-solde-pied">Mis à jour aujourd’hui</div></div>')
    s.j(f'tl.fromTo("#{sid}", {{ opacity: 0, y: 160, rotation: -6, scale: 0.8 }}, {{ opacity: 1, y: 0, rotation: 0, scale: 1, duration: 0.3, ease: "back.out(1.7)", immediateRender: false }}, {s.L(g)});')
    son(g, tour(["notif-positive", "pop-long", "clic-positif"]), 0.42, "le solde apparaît")
    son(g + 0.05, "pieces", 0.36, "argent")


ARTICLES = [("Riz", 30000), ("Huile", 15000), ("Viande", 25000), ("Tomates", 10000), ("Lait", 20000)]


def panier(s, pid, x, y, g, pas=0.22, total=100000):
    """Panier de courses : les articles tombent dedans un par un, puis le total."""
    lignes = "".join(f'<div id="{pid}-a{k}" class="fi-art" style="opacity: 0"><span>{nom}</span><b id="{pid}-p{k}">{fcfa(prix)}</b></div>'
                     for k, (nom, prix) in enumerate(ARTICLES))
    cam(s, f'<div id="{pid}" class="fi-panier" style="left: {x}px; top: {y}px; opacity: 0">'
           f'<div class="fi-panier-tete">Mon panier de courses</div>{lignes}'
           f'<div class="fi-total"><span>Total</span><b id="{pid}-t">{fcfa(total)}</b><em>FCFA</em></div></div>')
    s.j(f'tl.fromTo("#{pid}", {{ opacity: 0, x: 260 }}, {{ opacity: 1, x: 0, duration: 0.25, ease: "power4.out", immediateRender: false }}, {s.L(g)});')
    son(g, "swoosh-accent", 0.42, "le panier arrive")
    for k in range(len(ARTICLES)):
        gk = g + 0.25 + k * pas
        s.j(f'tl.fromTo("#{pid}-a{k}", {{ opacity: 0, y: -90, rotation: {(-8, 6, -5, 7, -6)[k]} }}, {{ opacity: 1, y: 0, rotation: 0, duration: 0.2, ease: "back.out(2)", immediateRender: false }}, {s.L(gk)});')
        son(gk, tour(["scanner-caisse", "pop-click", "scanner-caisse", "pop-sec"]), 0.38, f"article {ARTICLES[k][0]}")


def fleche_hausse(s, fid, x, y, g, texte="+5 %", taille=200, coul="#FF4D4D"):
    """Grosse flèche qui monte + pourcentage."""
    cam(s, f'<div id="{fid}" class="fi-hausse" style="left: {x}px; top: {y}px; color: {coul}; opacity: 0">'
           f'<svg viewBox="0 0 120 160" width="{round(taille * 0.6)}" height="{round(taille * 0.8)}"><path d="M60 8 L112 70 L80 70 L80 152 L40 152 L40 70 L8 70 Z" fill="{coul}" stroke="#0C0C0C" stroke-width="8" stroke-linejoin="round" /></svg>'
           f'<b style="font-size: {taille}px">{texte}</b></div>')
    s.j(f'tl.fromTo("#{fid}", {{ opacity: 0, y: 220, scale: 0.6 }}, {{ opacity: 1, y: 0, scale: 1, duration: 0.24, ease: "back.out(2)", immediateRender: false }}, {s.L(g)});')
    son(g, "swoosh-monte", 0.45, "ça monte")
    son(g + 0.15, "impact-basse", 0.55, texte)
    secousse(s, g + 0.15, 14)


def etiquettes(s, eid, x, y, items, g, pas=0.14):
    """Étiquettes de prix qui grimpent toutes (hausse GÉNÉRALE)."""
    html = "".join(f'<div id="{eid}-{k}" class="fi-etiq" style="opacity: 0"><span>{nom}</span><b>{av}</b><i>→</i><b class="fi-up">{ap}</b></div>'
                   for k, (nom, av, ap) in enumerate(items))
    cam(s, f'<div id="{eid}" class="fi-etiqs" style="left: {x}px; top: {y}px">{html}</div>')
    for k in range(len(items)):
        gk = g + k * pas
        s.j(f'tl.fromTo("#{eid}-{k}", {{ opacity: 0, x: -200 }}, {{ opacity: 1, x: 0, duration: 0.2, ease: "back.out(1.8)", immediateRender: false }}, {s.L(gk)});')
        son(gk, tour(["ping" if "ping" in PICS else "notif-indice", "pop-click", "compteur", "notif-indice"]), 0.34, f"étiquette {items[k][0]}")


def barre_pouvoir(s, bid, x, y, w, g, de, a, d):
    """Jauge « pouvoir d'achat » qui se vide."""
    cam(s, f'<div id="{bid}" class="fi-pouvoir" style="left: {x}px; top: {y}px; width: {w}px; opacity: 0">'
           f'<div class="fi-pouvoir-tete"><span>Pouvoir d’achat</span><b id="{bid}-n">{de} %</b></div>'
           f'<div class="fi-pouvoir-rail"><i id="{bid}-b" style="width: {de}%"></i></div></div>')
    s.j(f'tl.fromTo("#{bid}", {{ opacity: 0, y: 80 }}, {{ opacity: 1, y: 0, duration: 0.22, ease: "back.out(1.8)", immediateRender: false }}, {s.L(g)});')
    s.j(f'tl.to("#{bid}-b", {{ width: "{a}%", backgroundColor: "#FF4D4D", duration: {d}, ease: "power1.inOut" }}, {s.L(g + 0.3)});')
    s.compteur(f"#{bid}-n", g + 0.3, de, a, d, "pct")
    son(g + 0.3, "vent-roulement" if "vent-roulement" in PICS else "swell-court", 0.36, "le pouvoir d'achat fond", d=round(d, 2))


def graphe(s, gid, x, y, w, h, g_prix, g_epargne, d=1.1):
    """Deux courbes : les prix montent, la valeur réelle de l'épargne descend."""
    L = 1100
    cam(s, f'<div id="{gid}" class="fi-graphe" style="left: {x}px; top: {y}px; width: {w}px; height: {h}px; opacity: 0">'
           f'<svg viewBox="0 0 1000 560" width="{w}" height="{h}" preserveAspectRatio="none">'
           f'<line x1="60" y1="500" x2="980" y2="500" stroke="#3a4462" stroke-width="4" /><line x1="60" y1="40" x2="60" y2="500" stroke="#3a4462" stroke-width="4" />'
           f'<path id="{gid}-prix" d="M60 300 C 300 290, 520 210, 960 70" fill="none" stroke="#FF4D4D" stroke-width="16" stroke-linecap="round" stroke-dasharray="{L}" stroke-dashoffset="{L}" />'
           f'<path id="{gid}-ep" d="M60 300 C 300 310, 560 370, 960 450" fill="none" stroke="{BLEU}" stroke-width="16" stroke-linecap="round" stroke-dasharray="{L}" stroke-dashoffset="{L}" /></svg>'
           f'<b id="{gid}-lp" class="fi-graphe-l" style="right: 10px; top: 0; color: #FF4D4D; opacity: 0">Les prix ↑</b>'
           f'<b id="{gid}-le" class="fi-graphe-l" style="right: 10px; bottom: 200px; color: {BLEU}; opacity: 0">Ton épargne (valeur réelle) ↓</b></div>')
    s.j(f'tl.fromTo("#{gid}", {{ opacity: 0, scale: 0.9 }}, {{ opacity: 1, scale: 1, duration: 0.2, immediateRender: false }}, {s.L(g_prix - 0.25)});')
    s.j(f'tl.to("#{gid}-prix", {{ strokeDashoffset: 0, duration: {d}, ease: "power2.inOut" }}, {s.L(g_prix)});')
    s.j(f'tl.fromTo("#{gid}-lp", {{ opacity: 0, x: 60 }}, {{ opacity: 1, x: 0, duration: 0.2, immediateRender: false }}, {s.L(g_prix + d - 0.2)});')
    s.j(f'tl.to("#{gid}-ep", {{ strokeDashoffset: 0, duration: {d}, ease: "power2.inOut" }}, {s.L(g_epargne)});')
    s.j(f'tl.fromTo("#{gid}-le", {{ opacity: 0, x: 60 }}, {{ opacity: 1, x: 0, duration: 0.2, immediateRender: false }}, {s.L(g_epargne + d - 0.2)});')
    son(g_prix, "riser-synth", 0.36, "les prix montent", d=d)
    son(g_epargne, "swoosh-tourbillon" if "swoosh-tourbillon" in PICS else "swoosh-vol", 0.36, "l'épargne descend")


def deux_cartes(s, cid, g_a, g_b, g_diff):
    """ÉPARGNER | ≠ | INVESTIR, avec une vraie vidéo dans chaque carte."""
    def carte_v(k, titre_c, sous, video, g, x, coul):
        v = (f'<video id="{cid}-v{k}" class="clip" src="assets/video/{video}.mp4" data-start="{s.L(g)}" data-duration="{round(s.fin - g, 2)}" '
             f'data-track-index="{6 + k}" muted playsinline></video>')
        cam(s, f'<div id="{cid}-{k}" class="fi-duo" style="left: {x}px; top: 200px; border-color: {coul}; opacity: 0">{v}'
               f'<div class="fi-duo-titre" style="background: {coul}">{titre_c}</div><div class="fi-duo-sous">{sous}</div></div>')
        s.j(f'tl.fromTo("#{cid}-{k}", {{ opacity: 0, y: 200, rotation: {(-5, 5)[k]} }}, {{ opacity: 1, y: 0, rotation: {(-2, 2)[k]}, duration: 0.28, ease: "back.out(1.6)", immediateRender: false }}, {s.L(g)});')
        son(g, tour(["swoosh-accent", "impact-whoosh"]), 0.42, titre_c)
    carte_v(0, "Épargner", "Garder de côté", "tirelire", g_a, 150, "#ECECE8")
    carte_v(1, "Investir", "Faire travailler", "plante-pousse", g_b, 1110, BLEU)
    cam(s, f'<div id="{cid}-diff" class="fi-diff" style="opacity: 0"><i></i><i></i><u></u></div>')
    s.j(f'tl.fromTo("#{cid}-diff", {{ opacity: 0, scale: 2.4, rotation: -30 }}, {{ opacity: 1, scale: 1, rotation: 0, duration: 0.2, ease: "power4.in", immediateRender: false }}, {s.L(g_diff)});')
    son(g_diff, "impact-basse", 0.55, "ce n'est pas la même chose")
    secousse(s, g_diff + 0.2, 14)


def pile_pieces(s, pid, x, y, g, n=6, pas=0.12):
    """Piles de pièces dorées qui grandissent (l'argent qui travaille)."""
    piles = "".join(f'<div id="{pid}-{k}" class="fi-pile" style="height: {60 + k * 46}px; transform-origin: 50% 100%; opacity: 0"></div>' for k in range(n))
    cam(s, f'<div id="{pid}" class="fi-piles" style="left: {x}px; top: {y}px">{piles}</div>')
    for k in range(n):
        gk = g + k * pas
        s.j(f'tl.fromTo("#{pid}-{k}", {{ opacity: 0, scaleY: 0 }}, {{ opacity: 1, scaleY: 1, duration: 0.22, ease: "back.out(1.6)", immediateRender: false }}, {s.L(gk)});')
        son(gk, tour(["pieces", "piece-gagne", "pieces-2"]), 0.34, f"pile {k + 1}")


def profil_carte(s, cid, x, y, g, g_clic):
    """Carte du compte LeFinancier : avatar, nom, bouton « S'abonner » cliqué → « Abonné »."""
    cam(s, f'<div id="{cid}" class="fi-profil" style="left: {x}px; top: {y}px; opacity: 0"><img src="assets/img/profil.png" alt="" />'
           f'<div class="fi-profil-txt"><b>LeFinancier</b><span>Je t’explique l’argent en FCFA</span></div>'
           f'<div id="{cid}-btn" class="fi-btn">S’abonner</div><div id="{cid}-ok" class="fi-btn fi-btn-ok" style="opacity: 0">Abonné ✓</div></div>')
    s.j(f'tl.fromTo("#{cid}", {{ opacity: 0, y: 200, scale: 0.7 }}, {{ opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.8)", immediateRender: false }}, {s.L(g)});')
    son(g, "pop-long", 0.45, "la carte du compte")
    cam(s, f'<div id="{cid}-souris" class="fi-souris" style="left: {x + 1180}px; top: {y + 330}px; opacity: 0">'
           '<svg viewBox="0 0 40 56" width="70" height="98"><path d="M4 2 L4 46 L15 35 L23 53 L31 49 L23 32 L38 32 Z" fill="#fff" stroke="#0C0C0C" stroke-width="3" stroke-linejoin="round" /></svg></div>')
    s.j(f'tl.fromTo("#{cid}-souris", {{ opacity: 0, x: 300, y: 200 }}, {{ opacity: 1, x: 0, y: 0, duration: 0.4, ease: "power3.out", immediateRender: false }}, {s.L(g_clic - 0.45)});')
    s.j(f'tl.to("#{cid}-souris", {{ scale: 0.8, duration: 0.07, yoyo: true, repeat: 1 }}, {s.L(g_clic)});')
    s.j(f'tl.to("#{cid}-btn", {{ opacity: 0, duration: 0.08 }}, {s.L(g_clic + 0.06)});')
    s.j(f'tl.fromTo("#{cid}-ok", {{ opacity: 0, scale: 1.6 }}, {{ opacity: 1, scale: 1, duration: 0.18, ease: "back.out(2)", immediateRender: false }}, {s.L(g_clic + 0.06)});')
    son(g_clic, "clic-souris", 0.5, "clic S'abonner")
    son(g_clic + 0.08, "notif-positive", 0.45, "abonné")


def barre_x(s, xid, x, y, g, taille=300):
    """Grande croix rouge."""
    cam(s, f'<div id="{xid}" class="fi-x" style="left: {x}px; top: {y}px; width: {taille}px; height: {taille}px; opacity: 0"><i></i><i></i></div>')
    s.j(f'tl.fromTo("#{xid}", {{ opacity: 0, scale: 2.2 }}, {{ opacity: 1, scale: 1, duration: 0.16, ease: "power4.in", immediateRender: false }}, {s.L(g)});')
    son(g, "buzzer-faux", 0.5, "faux")


def pluie_fcfa(s, pid, g, n=18, d=1.4, valeur="10 000"):
    """Pluie de billets FCFA dessinés (stylisés, pas une reproduction de vrais billets)."""
    for k in range(n):
        x = (k * 137) % 1840 - 40
        r0, r1 = (-35 + (k * 23) % 70), (-200 + (k * 61) % 400)
        dk = d + (k % 4) * 0.12
        gk = g + (k % 6) * 0.06
        cam(s, f'<div id="{pid}-{k}" class="fi-billet" data-layout-ignore style="left: {x}px; top: -260px; opacity: 0"><b>{valeur}</b><span>Francs CFA</span><i></i></div>')
        s.j(f'tl.fromTo("#{pid}-{k}", {{ opacity: 1, y: 0, rotation: {r0} }}, {{ opacity: 1, y: 1500, rotation: {r1}, duration: {dk}, ease: "power1.in", immediateRender: false }}, {s.L(gk)});')
        s.j(f'tl.set("#{pid}-{k}", {{ opacity: 0 }}, {s.L(gk + dk)});')
    son(g, "billets" if "billets" in PICS else "papiers", 0.42, "pluie de billets FCFA")
    son(g + 0.1, tour(["pieces", "pieces-2"]), 0.36, "argent")


FI_CSS = """      .fi-solde { position: absolute; padding: 28px 34px 26px; background: #0f1b33; border: 4px solid #38bdf8; border-radius: 30px; font-family: "Inter", sans-serif; color: #ecece8; box-shadow: 0 40px 110px rgba(0, 0, 0, 0.7); }
      .fi-solde-tete { display: flex; align-items: center; gap: 14px; font-weight: 800; font-size: 34px; color: #38bdf8; margin-bottom: 14px; }
      .fi-solde-tete i { width: 26px; height: 26px; border-radius: 50%; background: #38bdf8; box-shadow: 0 0 22px rgba(56, 189, 248, 0.9); }
      .fi-solde > span { font-size: 34px; color: #9fb3c8; }
      .fi-solde-n { display: flex; align-items: baseline; gap: 14px; margin-top: 6px; }
      .fi-solde-n b { font-family: "Anton", sans-serif; font-weight: 400; font-size: 118px; line-height: 1.05; color: #fff; }
      .fi-solde-n em { font-style: normal; font-family: "Anton", sans-serif; font-size: 50px; color: #38bdf8; }
      .fi-solde-pied { margin-top: 10px; font-size: 34px; color: #9fb3c8; }
      .fi-panier { position: absolute; width: 640px; padding: 26px 32px; background: #f4f1ea; border-radius: 28px; font-family: "Inter", sans-serif; color: #0b1220; box-shadow: 0 40px 110px rgba(0, 0, 0, 0.7); }
      .fi-panier-tete { font-family: "Anton", sans-serif; font-size: 46px; text-transform: uppercase; margin-bottom: 12px; color: #0b1220; }
      .fi-art { display: flex; justify-content: space-between; align-items: center; font-size: 36px; font-weight: 700; padding: 8px 0; border-bottom: 3px dashed #c9c2b4; position: relative; }
      .fi-art b { font-weight: 800; }
      .fi-art.fi-barre::after { content: ""; position: absolute; left: -8px; right: -8px; top: 50%; height: 8px; background: #ff4d4d; border-radius: 4px; transform: rotate(-3deg); }
      .fi-total { display: flex; align-items: baseline; gap: 14px; margin-top: 14px; }
      .fi-total span { font-size: 34px; font-weight: 800; flex: 1; }
      .fi-total b { font-family: "Anton", sans-serif; font-weight: 400; font-size: 84px; line-height: 1; }
      .fi-total em { font-style: normal; font-family: "Anton", sans-serif; font-size: 40px; }
      .fi-hausse { position: absolute; display: flex; align-items: center; gap: 16px; font-family: "Anton", sans-serif; text-shadow: 0 10px 40px rgba(0, 0, 0, 0.7); }
      .fi-hausse b { font-weight: 400; line-height: 1; }
      .fi-etiqs { position: absolute; display: flex; flex-direction: column; gap: 16px; }
      .fi-etiq { display: flex; align-items: center; gap: 18px; padding: 14px 26px; background: #f4f1ea; color: #0b1220; border-radius: 16px; font-family: "Inter", sans-serif; font-size: 36px; font-weight: 800; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6); }
      .fi-etiq span { width: 230px; }
      .fi-etiq b { font-family: "Anton", sans-serif; font-weight: 400; font-size: 44px; color: #6b7280; }
      .fi-etiq b.fi-up { color: #ff4d4d; }
      .fi-etiq i { font-style: normal; color: #0b1220; }
      .fi-pouvoir { position: absolute; padding: 26px 32px; background: #0f1b33; border: 4px solid #3a4462; border-radius: 26px; font-family: "Anton", sans-serif; color: #ecece8; }
      .fi-pouvoir-tete { display: flex; justify-content: space-between; font-size: 56px; text-transform: uppercase; margin-bottom: 16px; }
      .fi-pouvoir-tete b { font-weight: 400; color: #38bdf8; }
      .fi-pouvoir-rail { height: 56px; border-radius: 28px; background: #1c2a47; overflow: hidden; }
      .fi-pouvoir-rail i { display: block; height: 100%; border-radius: 28px; background: #38bdf8; }
      .fi-graphe { position: absolute; padding: 0; }
      .fi-graphe-l { position: absolute; font-family: "Anton", sans-serif; font-weight: 400; font-size: 52px; text-shadow: 0 6px 30px rgba(0, 0, 0, 0.8); white-space: nowrap; }
      .fi-fait { position: absolute; width: 760px; padding: 24px 30px; background: #f4f1ea; color: #0b1220; border-left: 14px solid #38bdf8; border-radius: 18px; font-family: "Inter", sans-serif; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7); }
      .fi-fait b { display: block; font-family: "Anton", sans-serif; font-weight: 400; font-size: 64px; line-height: 1.05; }
      .fi-fait span { display: block; font-size: 30px; font-weight: 700; margin-top: 6px; }
      .fi-fait em { display: block; font-style: normal; font-size: 28px; color: #6b7280; margin-top: 10px; }
      .fi-duo { position: absolute; width: 660px; height: 560px; border: 8px solid; border-radius: 30px; overflow: hidden; background: #0b1220; box-shadow: 0 40px 110px rgba(0, 0, 0, 0.7); }
      .fi-duo video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .fi-duo-titre { position: absolute; left: 24px; top: 24px; padding: 10px 28px 4px; font-family: "Anton", sans-serif; font-size: 72px; text-transform: uppercase; color: #0b1220; border-radius: 12px; }
      .fi-duo-sous { position: absolute; left: 24px; bottom: 24px; padding: 8px 20px; background: rgba(11, 18, 32, 0.85); color: #fff; font-family: "Inter", sans-serif; font-weight: 800; font-size: 34px; border-radius: 12px; }
      .fi-diff { position: absolute; left: 870px; top: 380px; width: 180px; height: 180px; border-radius: 50%; background: #ff4d4d; box-shadow: 0 0 60px rgba(255, 77, 77, 0.8); }
      .fi-diff i { position: absolute; left: 40px; width: 100px; height: 20px; background: #fff; border-radius: 10px; }
      .fi-diff i:nth-child(1) { top: 66px; }
      .fi-diff i:nth-child(2) { top: 96px; }
      .fi-diff u { position: absolute; left: 82px; top: 30px; width: 18px; height: 122px; background: #fff; border-radius: 9px; transform: rotate(28deg); }
      .fi-piles { position: absolute; display: flex; align-items: flex-end; gap: 22px; height: 340px; }
      .fi-pile { width: 92px; border-radius: 12px; background: repeating-linear-gradient(0deg, #b07d00 0 6px, #f2b705 6px 30px, #ffe98a 30px 34px); border: 4px solid #0c0c0c; box-shadow: 0 0 30px rgba(242, 183, 5, 0.5); }
      .fi-profil { position: absolute; display: flex; align-items: center; gap: 30px; width: 1300px; padding: 30px 40px; background: #f4f1ea; border-radius: 34px; color: #0b1220; font-family: "Inter", sans-serif; box-shadow: 0 40px 120px rgba(0, 0, 0, 0.75); }
      .fi-profil img { width: 190px; height: 190px; border-radius: 50%; }
      .fi-profil-txt { flex: 1; }
      .fi-profil-txt b { display: block; font-family: "Anton", sans-serif; font-weight: 400; font-size: 92px; line-height: 1; }
      .fi-profil-txt span { font-size: 34px; font-weight: 700; color: #475569; }
      .fi-btn { position: absolute; right: 40px; top: 50%; margin-top: -54px; padding: 26px 46px; background: #fe2c55; color: #fff; border-radius: 18px; font-weight: 800; font-size: 44px; }
      .fi-btn-ok { background: #38bdf8; color: #0b1220; }
      .fi-souris { position: absolute; z-index: 5; }
      .fi-x { position: absolute; }
      .fi-x i { position: absolute; left: -10%; top: 44%; width: 120%; height: 12%; background: #ff4d4d; border-radius: 20px; box-shadow: 0 0 40px rgba(255, 77, 77, 0.8); transform: rotate(45deg); }
      .fi-x i + i { transform: rotate(-45deg); }
      .fi-equ { position: absolute; display: flex; align-items: center; gap: 30px; font-family: "Anton", sans-serif; font-size: 86px; color: #fff; text-transform: uppercase; }
      .fi-equ span { padding: 14px 30px 6px; background: #0f1b33; border: 4px solid #38bdf8; border-radius: 20px; }
      .fi-equ b { font-weight: 400; color: #38bdf8; }
      .fi-billet { position: absolute; width: 300px; height: 150px; border-radius: 12px; background: linear-gradient(135deg, #2f7fb8 0%, #38bdf8 45%, #f2b705 100%); border: 4px solid #0b1220; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6); font-family: "Anton", sans-serif; color: #0b1220; overflow: hidden; }
      .fi-billet b { position: absolute; left: 16px; top: 12px; font-weight: 400; font-size: 58px; line-height: 1; }
      .fi-billet span { position: absolute; left: 18px; bottom: 12px; font-size: 26px; text-transform: uppercase; letter-spacing: 0.05em; }
      .fi-billet i { position: absolute; right: 18px; top: 26px; width: 90px; height: 90px; border-radius: 50%; border: 6px solid rgba(11, 18, 32, 0.6); background: rgba(255, 255, 255, 0.35); }
