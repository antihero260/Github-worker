def cases_secret(s, cid, x, y, n=4, taille=150, g=None):
    """Les cases du mot secret : 4 lettres cachées (« ? » + cadenas)."""
    cases = "".join(f'<i id="{cid}-{k}"><b>?</b></i>' for k in range(n))
    cam(s, f'<div id="{cid}" class="ms-cases" style="left: {x}px; top: {y}px; --t: {taille}px; opacity: 0">{cases}</div>')
    if g is not None:
        s.j(f'tl.set("#{cid}", {{ opacity: 1 }}, {s.L(g)});')
        for k in range(n):
            s.j(f'tl.fromTo("#{cid}-{k}", {{ opacity: 0, y: -160, rotation: {(-10, 8, -6, 9)[k % 4]} }}, {{ opacity: 1, y: 0, rotation: 0, duration: 0.25, ease: "back.out(2)", immediateRender: false }}, {s.L(g + k * 0.09)});')
            son(g + k * 0.09, tour(["impact-tambour", "coup-mystere", "impact-futur"]), 0.38, f"case {k + 1}")


