zoom(s, T(109) - 0.04, 960, 450, 1.3, 0.12, 0.5)
zoom(s, T(113), 960, 540, 1.0, 0.18, 0.4)
zoom(s, T(123) - 0.05, 960, 400, 1.12, 0.14, 0.42)
s.ecrire()

