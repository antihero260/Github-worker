pose(s, "s06-toi", T(125), 0.14, "back.out(2)", bg=130, tete=8)
pose(s, "s06-toi", T(133), 0.14, "back.out(2)", bg=0, bd=-110, tete=-6)
panique(s, "s06-toi", T(147), 0.9)
zoom(s, T(125) - 0.05, 420, 420, 1.25, 0.2, 0.45)
suit(s, [(T(133) - 0.1, 900, 420), (T(137), 1450, 420)], 1.15, 0.25)
