# ================================================================ ÉLÉMENTS DE LA VIDÉO « PARIS SPORTIFS »
def ticket(s, tid, x, y, g, mise=1000, gain=2000, w=620):
    """Ticket de pari : match, mise, gain potentiel."""
    cam(s, f'<div id="{tid}" class="ps-ticket" style="left: {x}px; top: {y}px; width: {w}px; opacity: 0">'
           f'<div class="ps-ticket-tete">Ticket de pari</div><div class="ps-ticket-match"><span>Équipe A</span><i>vs</i><span>Équipe B</span></div>'
           f'<div class="ps-ligne"><span>Mise</span><b id="{tid}-m">{fcfa(mise)} F</b></div>'
           f'<div class="ps-ligne ps-gain"><span>Gain si tu gagnes</span><b><s id="{tid}-ga">{fcfa(gain)} F</s><em id="{tid}-g" style="opacity: 0">1 900 F</em></b></div></div>')
    s.j(f'tl.fromTo("#{tid}", {{ opacity: 0, y: 200, rotation: 8, scale: 0.7 }}, {{ opacity: 1, y: 0, rotation: -2, scale: 1, duration: 0.28, ease: "back.out(1.8)", immediateRender: false }}, {s.L(g)});')
    son(g, tour(["papier-glisse", "pop-long", "swoosh-accent"]), 0.45, "le ticket")


def chance(s, cid, x, y, g, taille=300):
    """Camembert 50 % : une chance sur deux."""
    cam(s, f'<div id="{cid}" class="ps-chance" style="left: {x}px; top: {y}px; opacity: 0"><svg viewBox="0 0 200 200" width="{taille}" height="{taille}">'
           f'<circle cx="100" cy="100" r="90" fill="#FF4D4D" stroke="#0B1220" stroke-width="8" /><path id="{cid}-p" d="M100 100 L100 10 A90 90 0 0 1 100 190 Z" fill="#38BDF8" stroke="#0B1220" stroke-width="8" /></svg>'
           f'<b>50 %</b><span>1 chance sur 2</span></div>')
    s.j(f'tl.fromTo("#{cid}", {{ opacity: 0, scale: 0.4, rotation: -180 }}, {{ opacity: 1, scale: 1, rotation: 0, duration: 0.35, ease: "back.out(1.6)", immediateRender: false }}, {s.L(g)});')
    son(g, "swoosh-tourbillon" if "swoosh-tourbillon" in PICS else "swoosh-vol", 0.45, "une chance sur deux")
    son(g + 0.3, "impact-tambour", 0.45, "50 %")


def grille(s, gid, x, y, g, g_ok, g_ko, n=100, col=20, taille=46, gap=8):
    """100 petits tickets qui apparaissent, puis 50 gagnés (bleu) et 50 perdus (rouge)."""
    cases = "".join(f'<i id="{gid}-{k}"></i>' for k in range(n))
    cam(s, f'<div id="{gid}" class="ps-grille" style="left: {x}px; top: {y}px; grid-template-columns: repeat({col}, {taille}px); gap: {gap}px; --t: {taille}px">{cases}</div>')
    s.j(f'tl.fromTo("#{gid} i", {{ opacity: 0, scale: 0 }}, {{ opacity: 1, scale: 1, duration: 0.12, stagger: 0.008, ease: "back.out(2)", immediateRender: false }}, {s.L(g)});')
    son(g, "pages-defilent", 0.42, "100 paris")
    gagnes = [k for k in range(n) if (k * 37) % 100 < 50]
    perdus = [k for k in range(n) if k not in gagnes]
    s.j(f'tl.to([{", ".join(chr(34) + "#" + gid + "-" + str(k) + chr(34) for k in gagnes)}], {{ backgroundColor: "#38BDF8", borderColor: "#38BDF8", duration: 0.1, stagger: 0.006 }}, {s.L(g_ok)});')
    s.j(f'tl.to([{", ".join(chr(34) + "#" + gid + "-" + str(k) + chr(34) for k in perdus)}], {{ backgroundColor: "#FF4D4D", borderColor: "#FF4D4D", duration: 0.1, stagger: 0.006 }}, {s.L(g_ko)});')
    son(g_ok, "cloche-succes", 0.4, "50 gagnés")
    son(g_ko, "buzzer-faux", 0.42, "50 perdus")


def compteur_carte_ps(s, cid, x, y, g, titre_c, de, a, d, coul="#FFFFFF", w=560):
    cam(s, f'<div id="{cid}" class="ps-cpt" style="left: {x}px; top: {y}px; width: {w}px; opacity: 0"><span>{titre_c}</span><b id="{cid}-n" style="color: {coul}">{fcfa(de)}</b><em>F</em></div>')
    s.j(f'tl.fromTo("#{cid}", {{ opacity: 0, x: -160 }}, {{ opacity: 1, x: 0, duration: 0.22, ease: "power4.out", immediateRender: false }}, {s.L(g)});')
    if de != a:
        compteur_fcfa(s, f"#{cid}-n", g + 0.1, de, a, d)
        son(g + 0.1, "compteur", 0.42, f"compteur {titre_c}", d=d)


def balance(s, bid, x, y, g):
    """Balance 50 | 50 parfaitement équilibrée."""
    cam(s, f'<div id="{bid}" class="ps-bal" style="left: {x}px; top: {y}px; opacity: 0"><div class="ps-bal-barre"></div>'
           f'<div class="ps-bal-p ps-bal-g"><b>50</b><span>gagnés</span></div><div class="ps-bal-p ps-bal-d"><b>50</b><span>perdus</span></div><div class="ps-bal-pied"></div></div>')
    s.j(f'tl.fromTo("#{bid}", {{ opacity: 0, y: 140 }}, {{ opacity: 1, y: 0, duration: 0.25, ease: "back.out(1.8)", immediateRender: false }}, {s.L(g)});')
    s.j(f'tl.fromTo("#{bid} .ps-bal-barre", {{ rotation: -12 }}, {{ rotation: 0, duration: 0.8, ease: "elastic.out(1, 0.4)", immediateRender: false }}, {s.L(g + 0.1)});')
    son(g, "cloche-bois", 0.42, "balance égale")


def fuite(s, fid, x0, y0, x1, y1, g, n=10, pas=0.12):
    """Pièces de 100 F qui partent d'un point vers un autre (vers la caisse du site)."""
    for k in range(n):
        gk = g + k * pas
        cam(s, f'<div id="{fid}-{k}" class="ps-piece" data-layout-ignore style="left: {x0}px; top: {y0}px; opacity: 0">100</div>')
        s.j(f'tl.fromTo("#{fid}-{k}", {{ opacity: 1, x: 0, y: 0, scale: 1 }}, {{ opacity: 1, x: {x1 - x0}, y: {y1 - y0}, scale: 0.7, duration: 0.5, ease: "power2.in", immediateRender: false }}, {s.L(gk)});')
        s.j(f'tl.set("#{fid}-{k}", {{ opacity: 0 }}, {s.L(gk + 0.5)});')
        son(gk + 0.45, tour(["piece-gagne", "pieces", "pieces-2"]), 0.32, "100 F pour le site")


PS_CSS = """      .ps-ticket { position: absolute; padding: 24px 30px; background: #f4f1ea; color: #0b1220; border-radius: 22px; font-family: "Inter", sans-serif; box-shadow: 0 40px 110px rgba(0, 0, 0, 0.7); border-top: 14px solid #38bdf8; }
      .ps-ticket-tete { font-family: "Anton", sans-serif; font-size: 44px; text-transform: uppercase; }
      .ps-ticket-match { display: flex; align-items: center; gap: 18px; font-weight: 800; font-size: 36px; margin: 10px 0 14px; }
      .ps-ticket-match i { font-style: normal; color: #6b7280; font-size: 30px; }
      .ps-ligne { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 0; border-top: 3px dashed #c9c2b4; font-size: 34px; font-weight: 700; }
      .ps-ligne b { font-family: "Anton", sans-serif; font-weight: 400; font-size: 64px; position: relative; }
      .ps-gain b s { text-decoration: none; position: relative; }
      .ps-gain b em { font-style: normal; color: #ff4d4d; position: absolute; right: 0; top: 70px; font-size: 86px; white-space: nowrap; }
      .ps-chance { position: absolute; text-align: center; font-family: "Anton", sans-serif; color: #fff; }
      .ps-chance b { display: block; font-weight: 400; font-size: 110px; line-height: 1; margin-top: 10px; }
      .ps-chance span { font-size: 48px; text-transform: uppercase; color: #38bdf8; }
      .ps-grille { position: absolute; display: grid; }
      .ps-grille i { width: var(--t); height: var(--t); border-radius: 8px; background: #1c2a47; border: 3px solid #3a4462; }
      .ps-cpt { position: absolute; padding: 20px 28px; background: #0f1b33; border: 4px solid #38bdf8; border-radius: 22px; font-family: "Anton", sans-serif; color: #ecece8; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7); }
      .ps-cpt span { display: block; font-size: 40px; text-transform: uppercase; color: #9fb3c8; }
      .ps-cpt b { font-weight: 400; font-size: 110px; line-height: 1; }
      .ps-cpt em { font-style: normal; font-size: 60px; color: #38bdf8; margin-left: 12px; }
      .ps-bal { position: absolute; width: 760px; height: 420px; }
      .ps-bal-barre { position: absolute; left: 40px; right: 40px; top: 120px; height: 22px; background: #ecece8; border-radius: 11px; transform-origin: 50% 50%; }
      .ps-bal-p { position: absolute; top: 160px; width: 260px; padding: 18px; border-radius: 22px; text-align: center; font-family: "Anton", sans-serif; color: #0b1220; }
      .ps-bal-p b { display: block; font-weight: 400; font-size: 120px; line-height: 1; }
      .ps-bal-p span { font-size: 40px; text-transform: uppercase; }
      .ps-bal-g { left: 20px; background: #38bdf8; }
      .ps-bal-d { right: 20px; background: #ff4d4d; }
      .ps-bal-pied { position: absolute; left: 365px; top: 130px; width: 30px; height: 280px; background: #ecece8; border-radius: 10px; }
      .ps-piece { position: absolute; width: 110px; height: 110px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffe98a, #f2b705 55%, #b07d00); border: 5px solid #0b1220; display: flex; align-items: center; justify-content: center; font-family: "Anton", sans-serif; font-size: 46px; color: #5a3d00; }
      .ps-caisse { position: absolute; width: 520px; padding: 26px 30px; background: #ff4d4d; color: #fff; border-radius: 26px; font-family: "Anton", sans-serif; text-align: center; box-shadow: 0 0 80px rgba(255, 77, 77, 0.6); }
      .ps-caisse span { display: block; font-size: 44px; text-transform: uppercase; }
      .ps-caisse b { font-weight: 400; font-size: 110px; line-height: 1; }
"""
CSS_AJOUT = FI_CSS + PS_CSS

