cam(s, perso("s05-toi", 1700, 930, 200))
vit(s, "s05-toi", s.debut, s.fin - 0.2)
panique(s, "s05-toi", T(109), 1.0)
pose(s, "s05-toi", T(114), 0.14, "back.out(2)", bg=130, tete=8)
