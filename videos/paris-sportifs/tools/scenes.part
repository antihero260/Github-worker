# ---------------------------------------------------------------- S5 : résultat −5 000 F alors que 50 / 50
s = scene(4, "Scène 5 · « Résultat : moins 5 000 francs, alors que tu as gagné autant de fois que tu as perdu ! »")
fond(s, "s05-f", (108, 109, 110, 111, 112, 114, 116, 117, 119, 121, 123),
     ("billets-brules", "choc-mains-tete", "portefeuille-vide", "plus-d-argent", "surpris-homme", "amis-but", "homme-but-salon", "frustree-compte", "choc-femme", "stress-tete", "inquiet-homme"), 0.68)
puce(s, "s05-res", "Résultat", 960, 170, T(108), "font-size: 60px")
choc_mot(s, "s05-n", "−5 000 F", 230, 300, T(109), T(112) + 0.1, "#FF4D4D")
son(T(109), "impact-basse", 0.65, "-5000")
son(T(110), "glitch-rugit", 0.45, "-5000")
son(T(110), "erreur-echec" if "erreur-echec" in PICS else "buzzer-faux", 0.42, "perte")
secousse(s, T(110), 26)
s.eclair(T(110))
balance(s, "s05-b", 580, 300, T(114))
s.j(f'tl.to("#s05-res", {{ opacity: 0, duration: 0.1 }}, {s.L(T(113))});')
tampon(s, "s05-quand", "Et pourtant −5 000 F", 600, 120, T(123), -5, 90, "#FF4D4D")
